{
  "extends": "@repo/tsconfig/nodejs.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
    "rootDir": "./",
    "outDir": "./dist",
    "composite": true,
    "incremental": true,
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "include": ["./"],
  "exclude": ["node_modules", "dist"]
}
