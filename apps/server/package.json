{
  "name": "@repo/server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch --conditions=development src/server.ts",
    "dev:watch": "nodemon --config nodemon.json",
    "build": "tsc -p tsconfig.json",
    "db:deploy": "prisma migrate deploy",
    "start": "node dist/server.js",
    "prod": "npm run db:deploy && npm run start"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/sensible": "6.0.4",
    "dotenv": "17.2.3",
    "fastify": "5.8.4",
    "fastify-type-provider-zod": "6.1.0",
    "pino": "10.3.1",
    "zod": "4.3.5",
    "@repo/utils": "workspace:*",
    "@repo/schemas": "workspace:*",
    "@repo/database": "workspace:*"
  },
  "devDependencies": {
    "@repo/eslint": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@repo/types": "workspace:*",
    "@types/node": "20.19.3",
    "nodemon": "3.1.11",
    "pino-pretty": "13.1.3",
    "tsx": "4.21.0",
    "typescript": "catalog:",
    "vitest": "4.0.17"
  }
}
