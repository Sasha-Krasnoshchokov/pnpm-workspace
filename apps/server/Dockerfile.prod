# Stage 1: Build
FROM node:22-alpine AS builder
ENV CI=true
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/server/package.json ./apps/server/
COPY packages/ ./packages/
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm build

# Stage 2: Production (The "Thin" Image)
FROM node:22-alpine AS production
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=6543

RUN corepack enable && corepack prepare pnpm@latest --activate

RUN apk add --no-cache curl && addgroup -S app && adduser -S app -G app

COPY --from=builder /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
COPY --from=builder /app/apps/server/package.json ./apps/server/
COPY --from=builder /app/apps/server/dist ./apps/server/dist
COPY --from=builder /app/packages/ ./packages/

RUN pnpm install --prod --frozen-lockfile --ignore-scripts --prefer-offline

HEALTHCHECK --interval=30s --timeout=3s \
  CMD curl -f http://localhost:6543/health || exit 1

USER app
EXPOSE 6543

CMD ["node", "--max-old-space-size=512", "apps/server/dist/server.js"]