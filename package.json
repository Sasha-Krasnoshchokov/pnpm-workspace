{
  "name": "monorepo-workspace",
  "version": "1.0.0",
  "description": "Production ready Monorepo Starter Kit",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.27.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "overrides": {
      "nth-check": ">=2.0.1",
      "fast-xml-parser": ">=4.4.1",
      "semver": "7.5.3",
      "cross-spawn": ">=7.0.5"
    }
  },
  "scripts": {
    "prepare": "husky",
    "lint": "pnpm --if-present -r run lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --parallel run build",
    "dev": "pnpm -r --parallel run dev",
    "dev:client": "pnpm --filter @repo/client run dev",
    "build:client": "pnpm --filter @repo/client run build",
    "dev:server": "pnpm --filter @repo/server run dev",
    "dev:server:watch": "pnpm --filter @repo/server run dev:watch",
    "build:server": "pnpm --filter @repo/server run build",
    "docker:dev:build": "docker build --no-cache --target development -t monorepo:dev -f apps/server/Dockerfile .",
    "docker:dev:run": "docker run -p 3210:3210 monorepo:dev",
    "docker:prod:build": "docker build --no-cache --target production -t monorepo:prod -f apps/server/Dockerfile .",
    "docker:prod:run": "docker run -p 6543:6543 monorepo:prod",
    "compose:up": "docker compose up --build",
    "compose:down": "docker compose down",
    "compose:restart": "docker compose down && docker compose up --build",
    "db:migrate:init": "pnpm --filter @repo/database run db:migrate:init",
    "db:migrate:auto": "pnpm --filter @repo/database run db:migrate:auto",
    "db:generate": "pnpm --filter @repo/database run db:generate",
    "db:studio": "pnpm --filter @repo/database run db:studio"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "9.1.2",
    "husky": "9.1.7",
    "prettier": "3.8.1",
    "typescript": "catalog:"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:"
  }
}
